{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "scamshield-bd-mcp",
      "version": "1.0.0",
      "title": "ScamShield BD"
    },
    "tools": [
      {
        "name": "check_message",
        "title": "Check a message for scams",
        "description": "Analyzes a suspicious SMS, Messenger, email or phone-call description for Bangladeshi scam patterns (fake bKash/Nagad 'wrong send' transfers, OTP/PIN theft, fake job offers, lottery wins, phishing links, impersonation) and returns a risk verdict, a 0-100 risk score, the exact red flags, and next steps.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The message text to check"
            },
            "sender": {
              "type": "string",
              "maxLength": 120,
              "description": "Who sent it, e.g. a phone number or name"
            },
            "channel": {
              "type": "string",
              "maxLength": 40,
              "description": "How it was sent: SMS, WhatsApp, Messenger, Email, Phone call, Website, or Other"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_practice_round",
        "title": "Get a scam-spotting practice round",
        "description": "Generates a round of 5 short practice messages (a mix of real Bangladeshi scam patterns and genuine messages) for ScamShield BD's 'Scam Spotter' quiz, used to train scam awareness. Returns structured items the Practice page renders directly.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "isScam": {
                    "type": "boolean"
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "redFlags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "message",
                  "isScam",
                  "explanation",
                  "redFlags"
                ],
                "additionalProperties": false
              }
            },
            "offline": {
              "type": "boolean"
            }
          },
          "required": [
            "items",
            "offline"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "lookup_scam_reports",
        "title": "Look up scam reports for a sender",
        "description": "Checks how many times a phone number, account number, or sender name has already been reported as a scam by the ScamShield BD community.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "description": "The phone number, account number, or sender name to look up"
            }
          },
          "required": [
            "identifier"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_district_scam_stats",
        "title": "Get scam report counts by district",
        "description": "Returns how many community scam reports exist per Bangladesh district, most-reported first, optionally filtered by channel (sender type: SMS, WhatsApp, Messenger, Email, Phone call, Website, or Other). Backs ScamShield BD's district reports view.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "maxLength": 40,
              "description": "Filter to only this channel, e.g. 'SMS' or 'Phone call'"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "districts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "district": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "number"
                  }
                },
                "required": [
                  "district",
                  "label",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "districts"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "get_trending_scam_types",
        "title": "Get trending scam types",
        "description": "Returns the most-reported scam categories across ScamShield BD's community reports, most common first (e.g. fake MFS wrong-send, OTP theft, fake job offers). Backs the Scam Map's trending section.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scamType": {
                    "type": "string"
                  },
                  "count": {
                    "type": "number"
                  }
                },
                "required": [
                  "scamType",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "types"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      }
    ]
  }
}
